theorem intersection (R : Finset (Fin 25)) :
    ∃ (q : Fin 81) (f : Fin 25 ↪ Fin 25) (h : Fin 30 ↪ Fin 30),
      (∀ i j, adj (f i) (h j) = adj i j) ∧ (∀ j, bits q (h j) = true ↔ ∀ i ∈ R, adj i j = true) := by
  induction R using Finset.induction_on with
  | empty =>
    refine ⟨0, Function.Embedding.refl _, Function.Embedding.refl _, fun _ _ => rfl, fun j => ?_⟩
    simp [root_all]
  | @insert i R _ ih =>
    obtain ⟨q,f,h,hpres,hbits⟩ := ih
    let t := transition q (f i)
    let w := word t.2
    refine ⟨t.1, f.trans ⟨rowMap w,row_inj w⟩, h.trans ⟨colMap w,col_inj w⟩, ?_, ?_⟩
    · intro a b
      exact (equivariant w (f a) (h b)).trans (hpres a b)
    · intro j
      change bits t.1 (colMap (word t.2) (h j)) = true ↔ _
      have hm := (correct t.2 : ∀ b, image t.2 b = colMap (word t.2) b) (h j)
      have hs := (step q : ∀ a b, bits (transition q a).1 (image (transition q a).2 b) = (bits q b && adj a b)) (f i) (h j)
      rw [← hm, hs, Bool.and_eq_true, hbits, hpres, Finset.forall_mem_insert]
      exact and_comm

