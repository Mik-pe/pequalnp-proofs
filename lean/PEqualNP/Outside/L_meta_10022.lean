def Interval {n : ℕ} (P : Fin n → Prop) (a b : ℕ) := ∀ i, a ≤ i.val → i.val < b → P i

theorem chunk {n : ℕ} (P : Fin n → Prop) [DecidablePred P] (a k : ℕ)
    (h : (List.range k).all (fun j => if h : a+j < n then decide (P ⟨a+j,h⟩) else true) = true) : Interval P a (a+k) := by
  intro i ha hb
  have hj : i.val-a < k := by omega
  have hk := List.all_eq_true.mp h (i.val-a) (List.mem_range.mpr hj)
  have he : a+(i.val-a) = i.val := by omega
  simpa [he,i.isLt] using hk

theorem join {n : ℕ} (P : Fin n → Prop) (a b c : ℕ) (u : Interval P a b) (v : Interval P b c) : Interval P a c := by
  intro i ha hc
  by_cases h : i.val < b
  · exact u i ha h
  · exact v i (by omega) hc

