def rowMap (w : List (Fin 5)) (i : Fin 25) := w.foldl (fun x g => rgen g x) i
def colMap (w : List (Fin 5)) (j : Fin 30) := w.foldl (fun x g => cgen g x) j

theorem row_inj (w) : Function.Injective (rowMap w) := by
  induction w with
  | nil => exact fun _ _ h => h
  | cons a w ih => exact ih.comp (rgen_inj a)

theorem col_inj (w) : Function.Injective (colMap w) := by
  induction w with
  | nil => exact fun _ _ h => h
  | cons a w ih => exact ih.comp (cgen_inj a)

theorem equivariant (w) (i j) : adj (rowMap w i) (colMap w j) = adj i j := by
  induction w generalizing i j with
  | nil => rfl
  | cons a w ih => exact (ih (rgen a i) (cgen a j)).trans (gen_adj a i j)

