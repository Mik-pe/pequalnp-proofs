theorem single (A : Finset (Fin 25)) (B : Finset (Fin 30)) (safe : ∀ i ∈ A, ∀ j ∈ B, adj i j = true) :
    A.card * B.card ≤ 54 := by
  obtain ⟨q,f,h,pres,inter⟩ := intersection A
  have hs : Function.Surjective h := Finite.surjective_of_injective h.injective
  have rows : A.map f ⊆ rowSet q := by
    intro x hx
    obtain ⟨a,ha,he⟩ := Finset.mem_map.mp hx
    subst x
    apply (enlarge q : ∀ i, (∀ j, bits q j = true → adj i j = true) → i ∈ rowSet q)
    intro b hb
    obtain ⟨j,rfl⟩ := hs b
    exact (pres a j).trans ((inter j).mp hb a ha)
  have cols : B.map h ⊆ colSet q := by
    intro y hy
    obtain ⟨b,hb,he⟩ := Finset.mem_map.mp hy
    subst y
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (inter b).mpr (fun a ha => safe a ha b hb)⟩
  simpa using (Nat.mul_le_mul (Finset.card_le_card rows) (Finset.card_le_card cols)).trans (area q)

def zeros : Finset (Fin 25 × Fin 30) := Finset.univ.filter (fun p => adj p.1 p.2)
